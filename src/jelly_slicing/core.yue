-- macro mark_key_state = (key)-> 
--     if love.keyboard.isDown(key)
--         kb[key] = love.timer.getTime!
--     else
--         kb[key] = never_pressed_time
--     return


never_pressed_time = -100
was_just_pressed = (key) ->
    was_down_before = (kb[key] ?? never_pressed_time) > 0
    -- $mark_key_state(key)
    if love.keyboard.isDown(key)
        kb[key] = love.timer.getTime!
    else
        kb[key] = never_pressed_time
    return love.keyboard.isDown(key) and not was_down_before

repeat_kb = {}
is_pressed_with_repeat_allowed = (key, repeat_time=.3) ->
    if not love.keyboard.isDown(key)
        repeat_kb[key] = nil
        return false
    if repeat_kb[key] == nil or love.timer.getTime! - repeat_kb[key] >= repeat_time
        repeat_kb[key] = love.timer.getTime!
        return true
    return false

mouse_before = {}
is_mouse_pressed_once = ->
    if not love.mouse.isDown(1)
        mouse_before[1] = false
        return false
    if love.mouse.isDown(1)
        if not mouse_before[1]
            mouse_before[1] = true
            return true
    return false

bring_focus_to_neighbors = ->
    x_offset = 0
    y_offset = 0
    if is_pressed_with_repeat_allowed "left"
        x_offset = -SMALLEST_SIZE_ALLOWED / 2
        is_using_mouse_for_nav = false
    if is_pressed_with_repeat_allowed "right"
        x_offset = SMALLEST_SIZE_ALLOWED / 2
        is_using_mouse_for_nav = false
        
    if is_pressed_with_repeat_allowed "up"
        y_offset = -SMALLEST_SIZE_ALLOWED / 2
        is_using_mouse_for_nav = false
    if is_pressed_with_repeat_allowed "down"
        y_offset = SMALLEST_SIZE_ALLOWED / 2
        is_using_mouse_for_nav = false
    
    if x_offset == 0 and y_offset == 0
        return

    cur_x, cur_y = rects[selected_index]\get_center(-SMALLEST_SIZE_ALLOWED / 2, -SMALLEST_SIZE_ALLOWED / 2)
    if love.keyboard.isDown("lshift")
        cur_x, cur_y = rects[selected_index]\get_center(SMALLEST_SIZE_ALLOWED / 2, SMALLEST_SIZE_ALLOWED / 2)

    screen_size_x = 800
    screen_size_y = 450
    while -10 <= cur_x <= screen_size_x and -10 <= cur_y <= screen_size_y
        cur_x += x_offset
        cur_y += y_offset
        -- print(cur_y, cur_x)
        for i, rect in ipairs rects
            if rect == rects[selected_index]
                continue
            if rect\contains(cur_x, cur_y)
                -- love.audio.play(slide_sound)
                slide_sound\clone()\play()
                selected_index = i
                return

did_slice_action = (repeat_time=.3) ->
    if has_won_current
        return false
    is_pressed_with_repeat_allowed("s", repeat_time) or is_pressed_with_repeat_allowed("space", repeat_time) or\
        is_pressed_with_repeat_allowed("return", repeat_time) or\
        is_mouse_pressed_once()


old_mouse_pos_x = -10
old_mouse_pos_y = -10
pingpong = (value, lower, upper) ->
    dist = (upper - lower)
    if math.floor(value / dist) % 2 == 1
        amount_over = value % dist
        return upper - amount_over
    return (value % dist) + lower

does_match_goal = ->
    for rect_to_find in *goal
        found = false
        for player_placed in *rects
            if rect_to_find\get_hash() == player_placed\get_hash()
                found = true
                break
        if not found
            return false
    return true
            

love.update = (dt) ->
    $doHotReload
    if love.window.hasFocus!
        $doHotReload
    reset_state_as_needed!
    -- print("before", is_using_mouse_for_nav)
    mouse_pos_x, mouse_pos_y = love.mouse.getPosition()
    if old_mouse_pos_x != mouse_pos_x or old_mouse_pos_y != mouse_pos_y
        old_mouse_pos_x = mouse_pos_x
        old_mouse_pos_y = mouse_pos_y
        is_using_mouse_for_nav = true
        -- print(old_mouse_pos_x, old_mouse_pos_y)
    -- print("after", is_using_mouse_for_nav)
    if was_just_pressed("tab") or was_just_pressed("t") or was_just_pressed("c")
        is_showing_goal_overlay = not is_showing_goal_overlay
    
    if is_pressed_with_repeat_allowed("z", .3)
        remove_from_undo_stack()

    if is_using_mouse_for_nav
        for i, rect in ipairs rects
            if rect\contains(mouse_pos_x, mouse_pos_y)
                selected_index = i
                break

    if does_match_goal! and not has_won_current
        print("matches")
        has_won_current = true
        current_level += 1
        win_sound\clone()\play()
        start_next_level_cooldown = 60
    
    start_next_level_cooldown = math.max(start_next_level_cooldown - 1, 0)
    if start_next_level_cooldown == 1
        has_done_initial_setup = false


    -- if love.keyboard.isDown "escape"
    if did_slice_action()
        split_rect_at(rects, selected_index)
    bring_focus_to_neighbors()
    love.graphics.setBackgroundColor 0.5, 0.8, 0.5, 1

love.draw = ->
    love.graphics.setFont(main_font)
    tile_size = 100
    -- print(mouse_pos_x, mouse_pos_y)
    should_draw = {true}
    if is_showing_goal_overlay
        should_draw[]=true
    rect_tables = {rects, goal}
    for table_num, rect_table in ipairs rect_tables
        unless should_draw[table_num]
            return
        for i, rect in ipairs rect_table
            rect.age += 1
            normal_view_alpha = 1
            ghost_alpha = ((math.sin(love.timer.getTime()*3) + 1) / 16.0) + .2
            if table_num == 1
                normal_view_alpha = if is_showing_goal_overlay then .2 else 1 
                if i == selected_index
                    love.graphics.setColor(.8, .6, .1, normal_view_alpha)
                else
                    love.graphics.setColor(.3, .6, .7, normal_view_alpha)
            if table_num == 2
                love.graphics.setColor(.3, .2, .0, ghost_alpha)

                
            if table_num == 1
                love.graphics.rectangle("fill", rect.x, rect.y, rect.width, rect.height)
                shrink_amount = rect.height * .05
                r, g, b, a = love.graphics.getColor()
                love.graphics.setColor(r, g * .75, b, a)
                love.graphics.rectangle("fill", rect.x + shrink_amount, rect.y + shrink_amount, rect.width - (shrink_amount * 2), rect.height - (shrink_amount * 2))
            if table_num == 1
                love.graphics.setColor(0, 0, 0, normal_view_alpha)
            else
                love.graphics.setColor(1, 1, 0, ghost_alpha)
            love.graphics.rectangle("line", rect.x, rect.y, rect.width, rect.height)
            eye_dist_from_center_x = rect.width / 5.0
            eye_dist_from_center_y = rect.height / 8.0
            mouth_dist_from_center_y = rect.height / 10.0
            center_x, center_y = rect\get_center()
            x_radius = rect.width / 16.0
            y_radius = rect.width / 16.0
            math.randomseed(rect\get_hash())
            eye_shake_time = 60
            mouth_size = math.min(rect.height, rect.width) * .03
            eye_offset = 0
            if rect.age < eye_shake_time
                eye_offset = ((eye_shake_time - rect.age) ^ (1.6 - rect.age / eye_shake_time)) / 10
            love.graphics.ellipse("fill", center_x + eye_dist_from_center_x, center_y + -1 * eye_dist_from_center_y + eye_offset, x_radius, y_radius)
            love.graphics.ellipse("fill", center_x - eye_dist_from_center_x, center_y + -1 * eye_dist_from_center_y - eye_offset, x_radius, y_radius)
            mouth_func = (func) ->
                clamped = math.min(rect.age, 30)
                return ((func(clamped / 1.5 + rect\get_hash()) + 3) * mouth_size)
            love.graphics.ellipse("fill", center_x, center_y + mouth_dist_from_center_y, 
                            mouth_func(math.cos), mouth_func(math.sin))
        
            if table_num == 1
                show_shadow_split_spot(selected_index)
            love.graphics.setColor(1, 1, 1, 1)
        love.graphics.print("Read instructions below", 10, 420)
    -- love.graphics.rectangle("fill", 10, 10, tile_size, tile_size)s
    love.graphics.setColor(1, 1, 1)
    -- if is_pressed_with_repeat_allowed("d", .2)
    --     print("registerd d")
    -- dump(board)
    -- if love.keyboard.isDown("f")
    --     love.graphics.print("cool", 32, 132)
    -- for i, name in ipairs names 
    --     love.graphics.print(i .. ": " .. name, 32, 132 + i * 30)

    -- love.graphics.setColor(0, 0, 0)
    -- show(rects)
    -- love.graphics.print(love.timer.getTime!)
