macro doHotReload = (cond) ->
  debugMode and "LuaReload.Monitor!" or ""


$reload_config false

dump = (table, indent="") -> 
    print(indent.."{")
    for k, v in pairs(table)
        if #indent > 0
            io.write indent
        io.write k .. ": "
        if type(v) == 'table'
            print!
            dump v, indent .. "    "
        else
            print(v) 
    print(indent.."}")

show = (to_show, indent="") -> 
    if to_show == nil
        return ""
    ret = "{\n"
    for k, v in pairs(to_show)
        if #indent > 0
            ret ..= indent
        ret ..= k .. ": "
        if type(v) == 'table'
            ret ..= "\n"
            ret ..= (show v, indent .. "    ")
        else
            ret ..= tostring(v) .. "\n"
    ret ..= "}"
    if indent == ""
        love.graphics.print(ret, 10, 10)
    return ret

class Rectangle
    new: (@x, @y, @width, @height, new_age=0) =>
        @age = new_age
    
    contains: (point_x, point_y) =>
        return @x <= point_x <= (@x + @width) and @y <= point_y <= (@y + @height)

    get_center: (offset_x=0, offset_y=0) =>
        return @x + (@width / 2) + offset_x, @y + (@height / 2) + offset_y
    
    get_top_left: () =>
        return @x, @y
    
    get_bottom_right: () =>
        return @x + @width, @y + @height
    
    get_hash: () =>
        return @x * 1000000 + @width * 1000 + @y * 100 + @height

    get_clone: () =>
        return Rectangle(@x, @y, @width, @height, @age)
    
test = Rectangle(4, )


main_font = love.graphics.newFont("CourierPrime-Regular.ttf", 28)
is_using_mouse_for_nav = false
rects = {}
goal = {}
undo_stack = {}

squish_sounds = [love.audio.newSource("sounds/squish#{i}.wav", "static") for i =1,3]
scream_sounds = [love.audio.newSource("sounds/scream#{i}.wav", "static") for i =1,3]
deny_sound = love.audio.newSource("sounds/deny.wav", "static")
slide_sound = love.audio.newSource("sounds/slide1.wav", "static")
undo_sound = love.audio.newSource("sounds/undo.wav", "static")
win_sound = love.audio.newSource("sounds/win.wav", "static")
selected_index = 1
kb = {}
SMALLEST_SIZE_ALLOWED = 20

