hide_errors = true

if hide_errors
    love.errorhandler = (msg) ->
        msg = tostring(msg)
        print(msg)
        $doHotReload
        love.graphics.print(msg, 10, 10)

has_done_initial_setup = false
is_showing_goal_overlay = true
has_won_current = false
current_level = 1
local split_rect_at
start_next_level_cooldown = 0

make_goal = ->
    goal = {}
    table.insert(goal, Rectangle(10, 10, 750, 400))
    math.randomseed(current_level)
    if current_level == 1
        for i=1,4
            split_rect_at(goal, math.random(#goal))
    elseif current_level == 2
        for i=1,5
            split_rect_at(goal, 1)
    else
        for i=1,7
            split_rect_at(goal, math.random(#goal))

is_showing_goal_overlay = false

reset_state_as_needed = ->
    if has_done_initial_setup
        return
    rects = {}
    undo_stack = {}
    selected_index = 1
    has_won_current = false
    table.insert(rects, Rectangle(10, 10, 750, 400))
    make_goal!
    has_done_initial_setup = true

    
-- macro debugLog = ()->
--     if show_logs
--         print() 

play_random_sound_from = (some_table) ->
    some_table[math.random(#some_table)]\clone()\play()

on_split_success = ->
    if love.keyboard.isDown("lshift")
        selected_index = #rects
    play_random_sound_from(scream_sounds)
    play_random_sound_from(squish_sounds)

choose_random_from = (some_table) ->
    return some_table[math.random(#some_table)]

add_to_undo_stack = ->
    undo_stack[]= [rect\get_clone() for rect in *rects]
    undo_stack[#undo_stack]["selected_index"] = selected_index
    -- print("end undo stack")


remove_from_undo_stack = ->
    if #undo_stack > 0
        rects = [rect\get_clone() for rect in *undo_stack[#undo_stack]]
        selected_index = undo_stack[#undo_stack]["selected_index"]
        undo_stack[#undo_stack] = nil
        undo_sound\clone()\play()
    else
        deny_sound\clone()\play()
    
split_rect_at = (to_split, index) ->
    with to_split[index]
        if .width > .height
            if .width / 2 >= SMALLEST_SIZE_ALLOWED
                if to_split == rects
                    add_to_undo_stack()
                width_before = .width
                .width /= 2
                half_width = .width
                .age = 0
                table.insert(to_split, Rectangle(.x + half_width, .y, half_width, .height))
                if to_split == rects
                    on_split_success!
                return
            
        else
            if .height / 2 >= SMALLEST_SIZE_ALLOWED
                if to_split == rects
                    add_to_undo_stack()
                height_before = .height
                .height /= 2
                half_height = .height
                .age = 0
                table.insert(to_split, Rectangle(.x, .y + half_height, .width, half_height))
                if to_split == rects
                    on_split_success!
                return
    -- deny_sound
    deny_sound\clone()\play()

show_shadow_split_spot = (index) ->
    with rects[index]
        if .width > .height
            if .width / 2 >= SMALLEST_SIZE_ALLOWED
                line_width = .width * .03
                half_line_width = line_width / 2
                -- vertical line
                width_before = .width
                moving_offset = math.sin(love.timer.getTime() * 10) * (.height * .1)
                half_rect_width = .width / 2
                love.graphics.rectangle("fill", 
                    .x + half_rect_width - half_line_width, .y + moving_offset, line_width, .height
                )
        else
            if .height / 2 >= SMALLEST_SIZE_ALLOWED
                line_width = .height * .05
                half_line_width = line_width / 2
                -- horizontal line
                moving_offset = math.sin(love.timer.getTime() * 10) * (.width * .1)
                height_before = .height
                half_height = .height / 2
                love.graphics.rectangle("fill", .x + moving_offset, .y + half_height - half_line_width,  .width, line_width)


love.keypressed = (key) ->
    if key == "r"
        has_done_initial_setup = false
    if key in {"q", "escape"}
        love.event.quit()
    if key == 'a'
        love.event.quit()

