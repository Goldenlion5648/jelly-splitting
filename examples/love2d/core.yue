import "love" 
-- import p from "yue"


dump = (table, indent="") -> 
    print("{")
    for k, v in pairs(table)
        if #indent > 0
            io.write indent
        io.write k .. ": "
        if type(v) == 'table'
            print!
            dump v, indent .. "    "
        else
            print(v) 
    print("}")

show = (to_show, indent="") -> 
    if to_show == nil
        return ""
    ret = "{\n"
    for k, v in pairs(to_show)
        if #indent > 0
            ret ..= indent
        ret ..= k .. ": "
        if type(v) == 'table'
            ret ..= "\n"
            ret ..= (show v, indent .. "    ")
        else
            ret ..= tostring(v) .. "\n"
    ret ..= "}"
    if indent == ""
        love.graphics.print(ret, 10, 10)
    return ret

class Rectangle
    new: (@x, @y, @width, @height) =>
    
    contains: (point_x, point_y) =>
        return @x <= point_x <= (@x + @width) and @y <= point_y <= (@y + @height)
    

main_font = love.graphics.newFont("CourierPrime-Regular.ttf", 28)
rects = {
    Rectangle(10, 10, 750, 400)
}
selected_index = 1
kb = {}

-- macro hide_errors = (hide_errors) ->
--   global debugMode = debugging == "true"
--   ""
hide_errors = false

if hide_errors
    love.errorhandler = (msg) ->
        msg = tostring(msg)
        print(msg)
        LuaReload.Monitor!
        love.graphics.print(msg, 10, 10)

reset_state = ->
    if #rects != 0
        return
    table.insert(rects, Rectangle(10, 10, 750, 400))

love.load = ->
    love.graphics.setBackgroundColor 0.5, 0.1, 0.5, 1
    

debug_text = ""
names = {"jo", "ron", "harry"}

-- macro debugLog = ()->
--     if show_logs
--         print() 
split_rect_at = (index) ->
    with rects[index]
        if .width > .height
            width_before = .width
            .width /= 2
            half_width = .width
            table.insert(rects, Rectangle(.x + half_width, .y, half_width, .height))
        else
            height_before = .height
            .height /= 2
            half_height = .height
            table.insert(rects, Rectangle(.x, .y + half_height, .width, half_height))
            


love.keypressed = (key) ->
    debug_text = ""
    if key == "e"
        debug_text ..= "e was pressed"
    if key == "r"
        reset_state()
    if key in {"q", "escape"}
        love.event.quit()
    if key == 'a'
        love.event.quit()

