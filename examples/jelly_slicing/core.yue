--     return


never_pressed_time = -100
was_just_pressed = (key) ->
    was_down_before = (kb[key] ?? never_pressed_time) > 0
    -- $mark_key_state(key)
    if love.keyboard.isDown(key)
        kb[key] = love.timer.getTime!
    else
        kb[key] = never_pressed_time
    return love.keyboard.isDown(key) and not was_down_before

repeat_kb = {}
is_pressed_with_repeat_allowed = (key, repeat_time=.3) ->
    if not love.keyboard.isDown(key)
        repeat_kb[key] = nil
        return false
    if repeat_kb[key] == nil or love.timer.getTime! - repeat_kb[key] >= repeat_time
        repeat_kb[key] = love.timer.getTime!
        return true
    return false

bring_focus_to_neighbors = ->
    x_offset = 0
    y_offset = 0
    if is_pressed_with_repeat_allowed "left"
        print("left")
        x_offset = -SMALLEST_SIZE_ALLOWED / 2
    if is_pressed_with_repeat_allowed "right"
        print("right")
        x_offset = SMALLEST_SIZE_ALLOWED / 2
        
    if is_pressed_with_repeat_allowed "up"
        print("up")
        y_offset = -SMALLEST_SIZE_ALLOWED / 2
    if is_pressed_with_repeat_allowed "down"
        print("down")
        y_offset = SMALLEST_SIZE_ALLOWED / 2
    
    -- print(x_offset, y_offset)
    if x_offset == 0 and y_offset == 0
        return

    -- print(rects[selected_index]\get_center())
    cur_x, cur_y = rects[selected_index]\get_center(-SMALLEST_SIZE_ALLOWED / 2, -SMALLEST_SIZE_ALLOWED / 2)
    if love.keyboard.isDown("lshift")
        cur_x, cur_y = rects[selected_index]\get_center(SMALLEST_SIZE_ALLOWED / 2, SMALLEST_SIZE_ALLOWED / 2)
    -- print(cur_x, cur_y)


    screen_size_x = 800
    screen_size_y = 450
    while -10 <= cur_x <= screen_size_x and -10 <= cur_y <= screen_size_y
        cur_x += x_offset
        cur_y += y_offset
        -- print(cur_y, cur_x)
        for i, rect in ipairs rects
            if rect == rects[selected_index]
                continue
            if rect\contains(cur_x, cur_y)
                selected_index = i
                return

did_slice_action = (repeat_time=.2) ->
    is_pressed_with_repeat_allowed("s", repeat_time) or is_pressed_with_repeat_allowed("space", repeat_time) or\
        is_pressed_with_repeat_allowed("return", repeat_time)

love.update = (dt) ->
    $doHotReload
    if love.window.hasFocus!
        $doHotReload
    -- if love.keyboard.isDown "escape"
    if did_slice_action()
        print("just pressed s")
        split_rect_at(selected_index)
    bring_focus_to_neighbors()
        

    love.graphics.setBackgroundColor 0.5, 0.8, 0.5, 1
    -- dump(just_pressed)
pingpong = (value, lower, upper) ->
    dist = (upper - lower)
    if math.floor(value / dist) % 2 == 1
        amount_over = value % dist
        return upper - amount_over
    return (value % dist) + lower


love.draw = ->
    love.graphics.setFont(main_font)
    tile_size = 100
    mouse_pos_x, mouse_pos_y = love.mouse.getPosition()
    -- print(mouse_pos_x, mouse_pos_y)
    for i, rect in ipairs rects
        if i == selected_index
            love.graphics.setColor(.8, .6, .1)
        else
            love.graphics.setColor(.3, .6, .7)
        
        rect.age += 1

        -- if rect\contains(mouse_pos_x, mouse_pos_y)
        --     love.graphics.setColor(1, 1, 1)
            
        love.graphics.rectangle("fill", rect.x, rect.y, rect.width, rect.height)
        love.graphics.setColor(0, 0, 0)
        love.graphics.rectangle("line", rect.x, rect.y, rect.width, rect.height)
        eye_dist_from_center_x = rect.width / 5.0
        eye_dist_from_center_y = rect.height / 8.0
        center_x, center_y = rect\get_center()
        x_radius = rect.width / 16.0
        y_radius = rect.width / 16.0
        math.randomseed(rect\get_hash())
        eye_shake_time = 60
        eye_offset = 0
        if rect.age < eye_shake_time
            eye_offset = ((eye_shake_time - rect.age) ^ (1.6 - rect.age / eye_shake_time)) / 10
        love.graphics.ellipse("fill", center_x + eye_dist_from_center_x, center_y + -1 * eye_dist_from_center_y + eye_offset, x_radius, y_radius)
        love.graphics.ellipse("fill", center_x - eye_dist_from_center_x, center_y + -1 * eye_dist_from_center_y - eye_offset, x_radius, y_radius)
        
    show_shadow_split_spot(selected_index)

    -- love.graphics.rectangle("fill", 10, 10, tile_size, tile_size)s
    love.graphics.setColor(1, 1, 1)
    if is_pressed_with_repeat_allowed("d", .2)
        print("registerd d")
