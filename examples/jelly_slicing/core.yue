macro reload_config = (debugging) ->
  global debugMode = debugging == "true"
  ""

macro doHotReload = (cond) ->
  debugMode and "LuaReload.Monitor!" or ""


$reload_config true

dump = (table, indent="") -> 
    print("{")
    for k, v in pairs(table)
        if #indent > 0
            io.write indent
        io.write k .. ": "
        if type(v) == 'table'
            print!
            dump v, indent .. "    "
        else
            print(v) 
    print("}")

show = (to_show, indent="") -> 
    if to_show == nil
        return ""
    ret = "{\n"
    for k, v in pairs(to_show)
        if #indent > 0
            ret ..= indent
        ret ..= k .. ": "
        if type(v) == 'table'
            ret ..= "\n"
            ret ..= (show v, indent .. "    ")
        else
            ret ..= tostring(v) .. "\n"
    ret ..= "}"
    if indent == ""
        love.graphics.print(ret, 10, 10)
    return ret

class Rectangle
    new: (@x, @y, @width, @height) =>
        @age = 0
    
    contains: (point_x, point_y) =>
        return @x <= point_x <= (@x + @width) and @y <= point_y <= (@y + @height)

    get_center: (offset_x=0, offset_y=0) =>
        return @x + (@width / 2) + offset_x, @y + (@height / 2) + offset_y
    
    get_top_left: () =>
        return @x, @y
    
    get_bottom_right: () =>
        return @x + @width, @y + @height
    
    get_hash: () =>
        return @x * 1000000 + @width * 1000 + @y * 100 + @height
    

main_font = love.graphics.newFont("CourierPrime-Regular.ttf", 28)
rects = {
    Rectangle(10, 10, 750, 400)
}

squish_sounds = [love.audio.newSource("sounds/squish#{i}.wav", "static") for i =1,3]
deny_sound = love.audio.newSource("sounds/deny.wav", "static")
selected_index = 1
kb = {}
SMALLEST_SIZE_ALLOWED = 20

-- macro hide_errors = (hide_errors) ->
--   global debugMode = debugging == "true"
--   ""
hide_errors = true

if hide_errors
    love.errorhandler = (msg) ->
        msg = tostring(msg)
        print(msg)
        $doHotReload
        love.graphics.print(msg, 10, 10)

reset_state = ->
    rects = {}
    table.insert(rects, Rectangle(10, 10, 750, 400))

love.load = ->
    love.graphics.setBackgroundColor 0.5, 0.1, 0.5, 1


    
-- macro debugLog = ()->
--     if show_logs
--         print() 

on_split_success = ->
    if love.keyboard.isDown("lshift")
        selected_index = #rects
    squish_sounds[math.random(#squish_sounds)]\play()


split_rect_at = (index) ->
    with rects[index]
        if .width > .height
            if .width / 2 >= SMALLEST_SIZE_ALLOWED
                width_before = .width
                .width /= 2
                half_width = .width
                .age = 0
                table.insert(rects, Rectangle(.x + half_width, .y, half_width, .height))
                on_split_success!
                return
            
        else
            if .height / 2 >= SMALLEST_SIZE_ALLOWED
                print .height
                height_before = .height
                .height /= 2
                half_height = .height
                .age = 0
                table.insert(rects, Rectangle(.x, .y + half_height, .width, half_height))
                on_split_success!
                return
    -- deny_sound
    deny_sound\play()

show_shadow_split_spot = (index) ->
    with rects[index]
        if .width > .height
            if .width / 2 >= SMALLEST_SIZE_ALLOWED
                line_width = .width * .05
                half_line_width = line_width / 2
                -- vertical line
                width_before = .width
                moving_offset = math.sin(love.timer.getTime() * 10) * (.height * .1)
                half_rect_width = .width / 2
                love.graphics.rectangle("fill", 
                    .x + half_rect_width - half_line_width, .y + moving_offset, line_width, .height
                )
        else
            if .height / 2 >= SMALLEST_SIZE_ALLOWED
                line_width = .height * .05
                half_line_width = line_width / 2
                -- horizontal line
                moving_offset = math.sin(love.timer.getTime() * 10) * (.width * .1)
                height_before = .height
                half_height = .height / 2
                love.graphics.rectangle("fill", .x + moving_offset, .y + half_height - half_line_width,  .width, line_width)


love.keypressed = (key) ->
    if key == "r"
        reset_state()
    if key in {"q", "escape"}
        love.event.quit()
    if key == 'a'
        love.event.quit()

