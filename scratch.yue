add_amount = (num, amount=10) -> num + amount
print add_amount(5,1)

class defaultdict
    new: (default_value)=>
        @default_value = default_value
    __index: (idx)=>
        if idx not in @
            @[idx] = @default_value
        @[idx]

counts = defaultdict(5)
counts[12] += 8
counts[16] = 3
p counts

obj = {
  hello: "world"
  day: "tuesday"
  length: 20
}

p obj

{hello: hello, day: the_day} = obj
print hello, the_day

:day = obj -- OK to do simple destructuring without braces
p day

